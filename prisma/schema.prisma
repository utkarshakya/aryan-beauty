generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  clerkUserId String     @unique
  role        UserRole   @default(customer)
  status      UserStatus @default(active)
  name        String?
  email       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customer    Customer?
}

model Customer {
  id           Int           @id @default(autoincrement())
  userId       Int?          @unique
  name         String
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  description  String        @default("")
  price        Float
  durationMin  Int
  category     String        @default("Other")
  createdAt    DateTime      @default(now())
  active       Boolean       @default(true)
  appointments Appointment[]
}

model BusinessSettings {
  id                    Int      @id @default(autoincrement())
  name                  String
  phone                 String?
  phoneDisplay          String?
  phoneHref             String?
  address               String?
  addressLine2          String?
  tagline               String?
  description           String?
  timeZone              String   @default("Asia/Kolkata")
  openingHours          Json     @default("{}")
  closedWeekdays        Int[]    @default([])
  closures              Json     @default("[]")
  slotIntervalMin       Int      @default(30)
  minBookingNoticeMin   Int      @default(60)
  cancellationCutoffMin Int      @default(120)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Appointment {
  id                 Int      @id @default(autoincrement())
  customerId         Int
  serviceId          Int
  serviceName        String   @default("")
  servicePrice       Int      @default(0)
  serviceDurationMin Int      @default(0)
  startTime          DateTime
  status             String   @default("pending")
  notes              String   @default("")
  createdAt          DateTime @default(now())
  endTime            DateTime
  customer           Customer @relation(fields: [customerId], references: [id])
  service            Service  @relation(fields: [serviceId], references: [id])

  @@index([startTime])
}

enum UserRole {
  super_admin
  admin
  staff
  customer
}

enum UserStatus {
  active
  disabled
}
